# ===== DeepSeek（AI 功能必填）=====
# 在 https://platform.deepseek.com 创建 API Key，只填在服务器环境变量里，不要写进前端代码
DEEPSEEK_API_KEY=
# 可选：自定义模型名或代理地址
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions

# ===== 登录会话签名密钥（生产必填）=====
# 随便生成一串 32 位以上的随机字符，例如在 PowerShell 执行：
# [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
AUTH_SECRET=

# ===== 数据库（不填则本地使用 .data/db.json，仅适合开发）=====
# 生产环境请填写 Supabase 项目地址与 service_role key（只在服务器使用）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
